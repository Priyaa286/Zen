# ==============================================================================
# Zen Global Docker Compose Environment Configuration
# ==============================================================================

# Application & Security
APP_ENV=production
DEBUG=false
SECRET_KEY=change_this_to_a_production_random_secret_in_deployment

# Database
SQLITE_DB_PATH=/app/data/zen.db

# Ollama Host
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# PayPal Credentials
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_or_live_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_or_live_client_secret

# FX Rates
EXCHANGE_RATE_API_KEY=

