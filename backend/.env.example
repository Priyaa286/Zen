# ==============================================================================
# Zen Global Backend Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME="Zen Cross-Border Shopping Agent"
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & CORS
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_here
CORS_ORIGINS=http://localhost:5173,http://localhost:80,https://zen.example.com

# Database Connection (Async SQLAlchemy)
DATABASE_URL=sqlite+aiosqlite:///./zen.db
MONGODB_URL=mongodb://localhost:27017/zen_db
SQLITE_DB_PATH=./zen.db

# Ollama AI Configuration (Local / Hosted LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=zen-fast
OLLAMA_TIMEOUT=60.0
OLLAMA_THINK=false

# Channel3 Multi-Store Search API
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_TIMEOUT=30.0

# Foreign Exchange (FX) Provider
FX_PROVIDER_BASE_URL=https://api.frankfurter.dev/v1
FX_PROVIDER_API_KEY=
FX_CACHE_TTL_SECONDS=3600
FX_TIMEOUT=10.0

# PayPal Payments Integration (Sandbox / Live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
