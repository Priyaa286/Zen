# Application Settings
APP_NAME="Zen Cross-Border Shopping Agent"
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# API Configuration
API_V1_STR=/api/v1

# CORS Origins (comma-separated list for frontend access)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database (Future Phase)
MONGODB_URL=mongodb://localhost:27017/zen_db

# AI Engine (Ollama - Phase 2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=zen-fast
OLLAMA_TIMEOUT=60
OLLAMA_THINK=False

# Channel3 Product Discovery (Phase 3)
CHANNEL3_API_KEY=your_channel3_api_key_here
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_TIMEOUT=30

# FX Rates Provider (Phase 4)
FX_PROVIDER_BASE_URL=https://api.frankfurter.dev/v1
FX_PROVIDER_API_KEY=
FX_CACHE_TTL_SECONDS=3600
FX_TIMEOUT=10

# PayPal REST API (Phase 5)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_MODE=sandbox

# Database Persistence (Phase 6)
MONGODB_URL=mongodb://localhost:27017/zen_db
SQLITE_DB_PATH=zen_local.db

