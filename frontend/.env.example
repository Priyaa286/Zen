# Zen Frontend Environment Variables

# FastAPI backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# Toggle dedicated frontend mock layer ("true" for independent development, "false" for live FastAPI backend)
VITE_USE_MOCK_API=true

# PayPal Sandbox Client ID from PayPal Developer Dashboard
# Leave as "sb" for basic PayPal sandbox SDK testing, or replace with your sandbox client ID
VITE_PAYPAL_CLIENT_ID=sb

# Default user shopping preferences
VITE_DEFAULT_CURRENCY=INR
VITE_DEFAULT_COUNTRY=IN
VITE_APP_NAME=Zen

# Backend Authentication & User Account feature gate ("true" once /api/auth/* & /api/users/* are deployed)
VITE_ENABLE_BACKEND_AUTH=false
VITE_GOOGLE_OAUTH_CLIENT_ID=
